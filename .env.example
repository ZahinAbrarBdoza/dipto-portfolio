# ── Contact form delivery ────────────────────────────────────────────────
#
# Copy this file to `.env.local` for local development, and add the same
# variable in your host's dashboard for production.
#
# Get a free access key at https://web3forms.com — enter the inbox you want
# messages delivered to and they email you the key. No account, no domain.
#
# Without this key the /api/contact route returns 503 and the form tells
# visitors to email directly. It never pretends a message was delivered.

WEB3FORMS_ACCESS_KEY=
